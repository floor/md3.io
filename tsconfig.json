{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["bun"],
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "jsxImportSource": "react"
  },
  "include": ["server.ts", "src/**/*.ts", "scripts/**/*.ts", "test/**/*.ts", "examples/**/*.ts", "examples/**/*.tsx"],
  "exclude": ["scripts/check-docs/prelude.ts", "scripts/check-docs/templates.d.ts"]
}
