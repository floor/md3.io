<!doctype html>
<html lang="en" data-navigation-shell="site-v1">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title><%= it.title %></title>
  <meta name="description" content="<%= it.description %>" />
  <link rel="canonical" href="https://md3.io<%= it.path %>" />
  <% if (it.noindex) { %><meta name="robots" content="noindex" /><% } %>
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta name="theme-color" content="#0c0c10" media="(prefers-color-scheme: dark)" />
  <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="md3.io" />
  <meta property="og:url" content="https://md3.io<%= it.path %>" />
  <meta property="og:title" content="<%= it.title %>" />
  <meta property="og:description" content="<%= it.description %>" />
  <meta property="og:image" content="https://md3.io/og-image.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="material. The Material component library: Material Design 3 for every framework" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:url" content="https://md3.io<%= it.path %>" />
  <meta name="twitter:title" content="<%= it.title %>" />
  <meta name="twitter:description" content="<%= it.description %>" />
  <meta name="twitter:image" content="https://md3.io/og-image.png" />
  <% (it.jsonLd || []).forEach(json => { %><script type="application/ld+json"><%~ json %></script>
  <% }); %>
  <link rel="preload" href="/fonts/DIN-Alternate-Regular.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/DIN-Alternate-Bold.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/IoskeleyMono-Regular.latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="stylesheet" href="/dist/css/<%= it.css %>.css" />
  <% if (it.isCatalog) { %><style data-page-head><%~ it.catalogTokens %></style><script type="module" src="/dist/catalog.js"></script><% } %><% (it.panelStylesheets || []).forEach(href => { %><link rel="preload" as="style" href="<%= href %>"><% }); %>
  <% if (it.isExamples) { %><script type="module" src="/dist/examples.js"></script><% } %>
  <% if (it.section === 'Styles') { %><script type="module" src="/dist/<%= it.script || 'styles' %>.js"></script><% } %>
  <script>
    (() => { let mode; try { mode = localStorage.getItem('md3-site-mode'); } catch {} document.documentElement.dataset.themeMode = mode === 'light' || mode === 'dark' ? mode : matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark'; })();
  </script>
  <script>
    // One appearance for the whole site: the header's Themes menu picks the material
    // theme, the moon the mode, and both reach the playground's preview and panel.
    // The theme is kept in md3-preview-appearance (the frames read it there); its mode
    // is the site mode, rewritten here so a frame loading below starts in step.
    (() => {
      const root = document.documentElement;
      const themes = <%~ JSON.stringify(it.themes || ['baseline']) %>;
      let saved = {};
      try { saved = JSON.parse(localStorage.getItem('md3-preview-appearance') || '{}') || {}; } catch {}
      root.dataset.siteTheme = themes.includes(saved.theme) ? saved.theme : 'baseline';
      // The whole page takes the theme, not only material's scopes: [data-theme]
      // on <html> is what the theme sheet keys its roles to, and tokens.css maps
      // the site's own colours onto them.
      root.dataset.theme = root.dataset.siteTheme;
      root.dataset.previewMode = root.dataset.themeMode;
      if (saved.mode !== root.dataset.themeMode) {
        try { localStorage.setItem('md3-preview-appearance', JSON.stringify({ ...saved, theme: root.dataset.siteTheme, mode: root.dataset.themeMode })); } catch {}
      }
    })();
  </script>
  <%/* The material scopes (the header's Themes control, a component page's panel) take the
       site theme: its main sheet is written here so their first paint is themed
       (parser-inserted, render-blocking); its contrast variant follows from theme-sheets.ts.
       No contrast.css on a site page. */%>
  <%~ include('theme-sheets-template', { themeSheets: it.themeSheets }) %>
  <script>(() => { const t = document.documentElement.dataset.siteTheme; const h = (JSON.parse(document.getElementById('theme-sheets').textContent) || {})[t]; if (h) { const url = ['/dist/material/themes/', t, '', h[0] ? '.' + h[0] : '', '.css'].join(''); document.write('<link rel="stylesheet" data-theme-sheet="' + t + '" data-part="theme" href="' + url + '">'); } })();</script>
  <script>
    (() => {
      const ids = ['vanilla', 'html', 'react', 'vue', 'svelte', 'solid'];
      let framework; try { framework = localStorage.getItem('md3-example-framework'); } catch {}
      // A documentation page's ?framework= chooses the framework before paint, and keeps it
      // (the old guide URLs redirect to /docs/frameworks/?framework=<id>).
      const asked = location.pathname.startsWith('/docs/') ? new URLSearchParams(location.search).get('framework') : null;
      if (ids.includes(asked)) { framework = asked; try { localStorage.setItem('md3-example-framework', asked); } catch {} }
      if (ids.includes(framework)) document.documentElement.dataset.framework = framework;
    })();
    (() => { let manager; try { manager = localStorage.getItem('md3-package-manager'); } catch {} if (['npm', 'pnpm', 'yarn', 'bun'].includes(manager)) document.documentElement.dataset.packageManager = manager; })();
  </script>
  <script type="module" src="/dist/site.js"></script>
</head>
<body class="<%= it.isHome ? 'home' : '' %>">
  <a class="skip-link" href="#<%= it.skipTarget %>">Skip to content</a>
  <%~ it.appBar %>
  <div class="site-primary-bar" id="site-primary-bar">
    <%~ include('primary-links', it) %>
  </div>
  <div class="layout">
    <div class="site-primary-rail" id="site-primary-rail">
      <%~ it.primaryRail %>
      <div class="header__themes <%= it.headerScope %>"><script>(s => { const r = document.documentElement; s.dataset.theme = r.dataset.siteTheme || 'baseline'; s.dataset.themeMode = r.dataset.themeMode; })(document.currentScript.parentElement);</script><%~ it.themeButton %><%~ it.themeMenu %><%~ it.modeButton %></div>
      <script>if (matchMedia('(width < 600px)').matches) document.querySelector('.header__actions').append(document.querySelector('.header__themes'));</script>
    </div>
    <div class="layout-main">
      <% if (it.sectionDrawer) { %>
        <details class="section-index" id="section-index">
          <summary class="section-index__toggle"><%= it.section + ' index' %></summary>
          <div class="section-index__links" id="sidebar">
            <%~ it.sectionDrawer %>
            <div class="sidebar__foot">material · Material Design 3<br><a href="https://github.com/floor/material/blob/main/LICENSE">MIT license</a><br>Icons: <a href="https://fonts.google.com/icons">Material Symbols</a> by Google, <a href="https://www.apache.org/licenses/LICENSE-2.0">Apache 2.0</a><br>Type: <a href="https://fonts.google.com/specimen/Roboto">Roboto</a> by Google, <a href="https://openfontlicense.org">OFL 1.1</a></div>
          </div>
        </details>
      <% } %>
      <main class="content" id="content" tabindex="-1"><%~ it.content %></main>
    </div>
  </div>
  <dialog class="site-nav-dialog" id="site-nav-dialog" aria-label="Navigation">
    <button type="button" class="site-icon-button site-nav-button" id="site-nav-close" aria-label="Close navigation" autofocus><%~ it.icon('close') %></button>
    <%~ include('primary-links', { ...it, withHome: true }) %>
  </dialog>
  <%~ include('search', { icon: it.icon, showcasePublic: it.showcasePublic }) %>
</body></html>
