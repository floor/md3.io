<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= it.title %></title>
  <meta name="description" content="<%= it.description %>" />
  <link rel="canonical" href="https://md3.io<%= it.path %>" />
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta name="theme-color" content="#0c0c10" media="(prefers-color-scheme: dark)" />
  <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="md3.io" />
  <meta property="og:url" content="https://md3.io<%= it.path %>" />
  <meta property="og:title" content="<%= it.title %>" />
  <meta property="og:description" content="<%= it.description %>" />
  <meta property="og:image" content="https://md3.io/og-image.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="material — Material Design 3 for every framework" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:url" content="https://md3.io<%= it.path %>" />
  <meta name="twitter:title" content="<%= it.title %>" />
  <meta name="twitter:description" content="<%= it.description %>" />
  <meta name="twitter:image" content="https://md3.io/og-image.png" />
  <% (it.jsonLd || []).forEach(json => { %><script type="application/ld+json"><%~ json %></script>
  <% }); %>
  <link rel="preload" href="/fonts/DIN-Alternate-Regular.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/DIN-Alternate-Bold.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/IoskeleyMono-Regular.latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="stylesheet" href="/dist/css/<%= it.css %>.css" />
  <% if (it.isCatalog) { %><style><%~ it.catalogTokens %></style><script type="module" src="/dist/catalog.js"></script><% } %>
  <% if (it.section === 'Examples') { %><script type="module" src="/dist/examples.js"></script><% } %>
  <% if (it.section === 'Styles') { %><script type="module" src="/dist/<%= it.script || 'styles' %>.js"></script><% } %>
  <script>
    (() => { let mode; try { mode = localStorage.getItem('md3-site-mode'); } catch {} document.documentElement.dataset.themeMode = mode === 'light' || mode === 'dark' ? mode : matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark'; })();
  </script>
  <script>
    (() => {
      let mode = 'light';
      try { mode = JSON.parse(localStorage.getItem('md3-preview-appearance') || '{}')?.mode; } catch {}
      document.documentElement.dataset.previewMode = mode === 'dark' ? 'dark' : 'light';
    })();
  </script>
  <script>
    (() => { let framework; try { framework = localStorage.getItem('md3-example-framework'); } catch {} if (['vanilla', 'html', 'react', 'vue', 'svelte', 'solid'].includes(framework)) document.documentElement.dataset.framework = framework; })();
    (() => { let manager; try { manager = localStorage.getItem('md3-package-manager'); } catch {} if (['npm', 'pnpm', 'yarn', 'bun'].includes(manager)) document.documentElement.dataset.packageManager = manager; })();
  </script>
  <script type="module" src="/dist/site.js"></script>
</head>
<body class="<%= it.isHome ? 'home' : '' %>">
  <a class="skip-link" href="#content">Skip to content</a>
  <header class="header"><div class="header__inner">
    <a class="header__logo" href="/"><img class="header__mark" src="/assets/brand/mark.svg" width="20" height="20" alt="" aria-hidden="true">material<span class="brand-dot">.</span></a>
    <% if (it.section) { %><span class="header__sep">/</span><span class="header__section"><%= it.section %></span><% } %>
    <nav class="header__nav" aria-label="Main navigation">
      <a href="/components/" class="<%= it.section === 'Components' ? 'active' : '' %>">Components</a>
      <a href="/styles/" class="<%= it.section === 'Styles' ? 'active' : '' %>">Styles</a>
      <a href="/examples/" class="<%= it.section === 'Examples' ? 'active' : '' %>">Examples</a>
      <a href="/docs/" class="<%= it.section === 'Documentation' ? 'active' : '' %>">Documentation</a>
      <a href="https://github.com/floor/material" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
    </nav>
    <button type="button" class="header__search" id="search-trigger" aria-label="Search (⌘K)" aria-haspopup="dialog" aria-keyshortcuts="Meta+K Control+K">
      <svg class="header__search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      <span class="header__search-kbd" aria-hidden="true"><kbd>⌘</kbd><kbd>K</kbd></span>
    </button>
    <button type="button" class="header__theme" id="theme-toggle" aria-label="Toggle site theme">
      <svg class="header__theme-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"/></svg>
      <svg class="header__theme-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M21 13A9 9 0 0 1 11 3a9 9 0 1 0 10 10Z"/></svg>
    </button>
    <button type="button" class="header__hamburger" id="hamburger" aria-label="Open navigation" aria-expanded="false" aria-controls="sidebar"><svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 5h14M3 10h14M3 15h14"/></svg></button>
  </div></header>
  <button id="overlay" class="overlay" type="button" aria-label="Close navigation" hidden></button>
  <div class="layout">
    <nav class="sidebar <%= it.isHome ? 'sidebar--home' : '' %>" id="sidebar" aria-label="<%= it.section || 'Site' %> navigation">
      <div class="sidebar__group mobile-navigation"><a class="sidebar__link" href="/components/">Components</a><a class="sidebar__link" href="/styles/">Styles</a><a class="sidebar__link" href="/docs/">Documentation</a><a class="sidebar__link" href="https://github.com/floor/material">GitHub ↗</a></div>
      <% it.sidebarGroups.forEach(group => { %><div class="sidebar__group"><div class="sidebar__label"><%= group.label %></div><% group.items.forEach(item => { %>
        <a class="sidebar__link <%= it.path === item.href ? 'sidebar__link--active' : '' %>" href="<%= item.href %>" <% if (it.path === item.href) { %>aria-current="page"<% } %>><%= item.name %></a>
      <% }); %></div><% }); %>
      <div class="sidebar__foot">material · Material Design 3<br><a href="https://github.com/floor/material/blob/main/LICENSE">MIT license</a><br>Icons: <a href="https://fonts.google.com/icons">Material Symbols</a> by Google, <a href="https://www.apache.org/licenses/LICENSE-2.0">Apache 2.0</a><br>Type: <a href="https://fonts.google.com/specimen/Roboto">Roboto</a> by Google, <a href="https://openfontlicense.org">OFL 1.1</a></div>
    </nav>
    <main class="content" id="content" tabindex="-1"><%~ it.content %></main>
  </div>
  <%~ include('search') %>
</body></html>
