<%/* One configuration control as the native panel renders it. component.eta's native
   panel, and the material panel for the kinds it does not render as elements yet. */%>
<% const control = it.control; %>
        <% if (control.kind === 'toggle') { %>
          <label class="ui-row ui-switch"<% if (control.replaced) { %> data-replaced="<%= control.replaced %>"<% } %>><span class="control-label"><%= control.label %></span><span><input type="checkbox" name="<%= control.key %>" <%= control.initial ? 'checked' : '' %> <% if (control.enabledWhen) { %>data-enabled-when="<%= control.enabledWhen %>"<% } %> /><span class="ui-switch__track"></span></span></label>
        <% } else if (['text', 'date', 'time'].includes(control.kind)) { %>
          <div class="ui-row control-row"<% if (control.replaced) { %> data-replaced="<%= control.replaced %>"<% } %>><label class="control-label" for="<%= it.slug %>-<%= control.key %>"><%= control.label %></label><input class="ui-input control-input" type="<%= control.kind %>" <% if (control.kind === 'time') { %>step="1"<% } %> <% if (control.enabledWhen) { %>data-enabled-when="<%= control.enabledWhen %>"<% } %> id="<%= it.slug %>-<%= control.key %>" name="<%= control.key %>" value="<%= control.initial %>" maxlength="80" autocomplete="off" /></div>
        <% } else if (control.kind === 'range') { %>
          <div class="ui-row control-row"<% if (control.replaced) { %> data-replaced="<%= control.replaced %>"<% } %>><label class="control-label" for="control-<%= control.key %>"><%= control.label %></label><div class="control-range"><output for="control-<%= control.key %>" data-value-for="<%= control.key %>"><%= control.initial %></output><input class="ui-slider" type="range" id="control-<%= control.key %>" name="<%= control.key %>" value="<%= control.initial %>" min="<%= control.min %>" max="<%= control.max %>" step="<%= control.step %>" <% if (control.enabledWhen) { %>data-enabled-when="<%= control.enabledWhen %>"<% } %> /></div></div>
        <% } else if (control.kind === 'select') { %>
          <div class="ui-row control-row"<% if (control.replaced) { %> data-replaced="<%= control.replaced %>"<% } %>><label class="control-label" for="control-<%= control.key %>"><%= control.label %></label><select class="ui-select" id="control-<%= control.key %>" name="<%= control.key %>" <% if (control.enabledWhen) { %>data-enabled-when="<%= control.enabledWhen %>"<% } %>><% control.options.forEach(value => { %><option value="<%= value %>" <%= value === control.initial ? 'selected' : '' %>><%= control.labels?.[value] || (value ? value.replaceAll('-', ' ') : 'None') %></option><% }); %></select></div>
        <% } else { %>
          <div class="ui-row control-row" role="group" aria-labelledby="label-<%= control.key %>"<% if (control.replaced) { %> data-replaced="<%= control.replaced %>"<% } %>><span class="control-label" id="label-<%= control.key %>"><%= control.label %></span><div class="ui-segmented choice-group <%= control.kind === 'icons' ? 'choice-group--icons' : control.key === 'size' ? 'choice-group--sizes' : '' %>"><% control.options.forEach(value => { %><label class="choice" <% if (control.kind === 'icons') { %>title="<%= value %>"<% } %>><input type="radio" name="<%= control.key %>" value="<%= value %>" <% if (control.enabledWhen) { %>data-enabled-when="<%= control.enabledWhen %>"<% } %> <%= value === control.initial ? 'checked' : '' %> <% if (control.kind === 'icons') { %>aria-label="<%= value %>"<% } %> /><span class="ui-segmented__btn"><% if (control.kind === 'icons' && it.icons[value]) { %><%~ it.icons[value] %><% } else { %><%= control.labels?.[value] || (control.key === 'size' && value.length <= 2 ? value.toUpperCase() : value === 'none' && control.kind === 'icons' ? 'None' : value) %><% } %></span></label><% }); %></div></div>
        <% } %>
