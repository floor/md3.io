<div class="page-wrap component-page" data-component="<%= it.slug %>">
  <nav class="framework-tabs" role="tablist" aria-label="Framework">
    <% [['vanilla','Vanilla'],['html','Web Components'],['react','React'],['vue','Vue'],['svelte','Svelte'],['solid','SolidJS']].forEach(([id, label]) => { const available = id === 'vanilla' || !!it.element; %>
    <button type="button" class="framework-tab" role="tab" data-framework="<%= id %>" aria-selected="false" tabindex="-1" <%= available ? '' : 'disabled' %> <% if (!available) { %>title="Coming with the <%= it.component.name.toLowerCase() %> web component"<% } %>><%= label %></button>
    <% }); %>
  </nav>
  <header class="page-heading"><div class="page-heading__top"><span class="eyebrow"><%= it.component.group.toUpperCase() %> / <%= it.component.name.toUpperCase() %></span><a class="text-link" href="/docs/components/<%= it.slug %>/">Documentation ↗</a></div><h1><%= it.component.name %></h1><p><%= it.component.description %></p></header>
  <section class="playground" aria-label="<%= it.component.name %> playground">
    <div class="preview-panel">
      <div class="panel-heading preview-heading">
        <div class="preview-tabs" role="tablist" aria-label="Playground view">
          <button type="button" class="preview-tab" id="live-tab" role="tab" aria-selected="true" aria-controls="live-panel">Live preview</button>
          <button type="button" class="preview-tab" id="code-tab" role="tab" aria-selected="false" aria-controls="code-panel" tabindex="-1">View code</button>
        </div>
        <span class="preview-dot" aria-hidden="true"></span>
        <div class="preview-appearance" role="group" aria-label="Preview appearance">
          <label for="preview-theme">Theme</label>
          <select id="preview-theme" class="ui-select" name="theme" form="configuration"><% it.themes.forEach(theme => { %><option value="<%= theme %>"><%= (theme.charAt(0).toUpperCase() + theme.slice(1)).replaceAll('-', ' ') %></option><% }); %></select>
          <div class="ui-segmented choice-group choice-group--mode" role="group" aria-label="Preview mode">
            <label class="choice"><input name="mode" type="radio" value="light" form="configuration" checked /><span class="ui-segmented__btn">Light</span></label>
            <label class="choice"><input name="mode" type="radio" value="dark" form="configuration" /><span class="ui-segmented__btn">Dark</span></label>
          </div>
        </div>
      </div>
      <div class="playground-space">
        <button class="ui-btn preview-copy" id="copy-code" type="button" hidden><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="8" y="8" width="12" height="12" rx="2"/><path d="M16 8V4H4v12h4"/></svg> Copy code</button>
        <div id="live-panel" class="playground-view" role="tabpanel" aria-labelledby="live-tab"><iframe id="preview" title="Interactive <%= it.component.name.toLowerCase() %> preview, from the material library" src="/preview/<%= it.slug %>/"></iframe></div>
        <div id="code-panel" class="playground-view code-panel" role="tabpanel" aria-labelledby="code-tab" tabindex="0" hidden>
          <% if (!it.element) { %><p class="framework-note">Web Components, React, Vue, Svelte and SolidJS come with the <%= it.component.name.toLowerCase() %> web component; the vanilla factory works in any of them today.</p><% } %>
          <pre><code id="generated-code" class="hljs language-javascript"></code></pre>
        </div>
        <% if (it.element) { %><script type="application/json" id="element-meta"><%~ JSON.stringify(it.element).replaceAll('<', '\\u003c') %></script><% } %>
      </div>
      <div class="preview-footer">
        <span id="playground-status" role="status" aria-live="polite">Loading preview…</span>
        <% if (it.size) { const kb = n => (n / 1024).toFixed(1); %><span class="component-size"><% [['factory', it.size.factory], ...(it.element ? [['element', it.size.element]] : [])].forEach(([flavour, size]) => { %><span data-flavour="<%= flavour %>" <%= flavour === 'factory' ? '' : 'hidden' %> title="What this component adds to an app: minified JS and CSS, gzip, on top of the material library's shared core, which all components share and a page loads once.<% if (size.lazy) { %> Another <%= kb(size.lazy) %> KB loads later, only if a feature needs it.<% } %> Measured on material <%= it.size.material %>."><strong><%= kb(size.added) %> KB</strong> gzip</span><% }); %></span><% } %>
      </div>
    </div>
    <form class="split-panel configuration" id="configuration">
      <div class="panel-heading"><h2 class="ui-title">CONFIGURATION</h2><button type="reset" class="reset-button">Reset</button></div>
      <div class="configuration-body">
      <% if (it.slug === 'chips') { %><input type="hidden" name="selectedChips" id="chips-selectedChips" value="" /><% } %>
      <% if (it.component.scenarios.length) { %>
      <section class="ui-section scenario-setup">
        <div class="ui-row control-row"><label class="control-label" for="scenario">Scenario</label><select class="ui-select" id="scenario" aria-describedby="scenario-description"><option value="default" selected>Default</option><% it.component.scenarios.forEach(scenario => { %><option value="<%= scenario.id %>"><%= scenario.name %></option><% }); %><option value="custom">Custom</option></select></div>
        <p class="scenario-description" id="scenario-description">The options this playground starts with.</p>
      </section>
      <% } %>
      <% [...new Set(it.component.controls.map(control => control.section))].forEach(section => { %>
      <section class="ui-section configuration-controls" aria-labelledby="section-<%= section.toLowerCase() %>">
      <h3 class="ui-title" id="section-<%= section.toLowerCase() %>"><%= section %></h3>
      <% it.component.controls.filter(control => control.section === section).forEach(control => { %>
        <% if (control.kind === 'toggle') { %>
          <label class="ui-row ui-switch"<% if (control.replaced) { %> data-replaced<% } %>><span class="control-label"><%= control.label %></span><span><input type="checkbox" name="<%= control.key %>" <%= control.initial ? 'checked' : '' %> <% if (control.enabledWhen) { %>data-enabled-when="<%= control.enabledWhen %>"<% } %> /><span class="ui-switch__track"></span></span></label>
        <% } else if (['text', 'date', 'time'].includes(control.kind)) { %>
          <div class="ui-row control-row"<% if (control.replaced) { %> data-replaced<% } %>><label class="control-label" for="<%= it.slug %>-<%= control.key %>"><%= control.label %></label><input class="ui-input control-input" type="<%= control.kind %>" <% if (control.kind === 'time') { %>step="1"<% } %> <% if (control.enabledWhen) { %>data-enabled-when="<%= control.enabledWhen %>"<% } %> id="<%= it.slug %>-<%= control.key %>" name="<%= control.key %>" value="<%= control.initial %>" maxlength="80" autocomplete="off" /></div>
        <% } else if (control.kind === 'range') { %>
          <div class="ui-row control-row"<% if (control.replaced) { %> data-replaced<% } %>><label class="control-label" for="control-<%= control.key %>"><%= control.label %></label><div class="control-range"><output for="control-<%= control.key %>" data-value-for="<%= control.key %>"><%= control.initial %></output><input class="ui-slider" type="range" id="control-<%= control.key %>" name="<%= control.key %>" value="<%= control.initial %>" min="<%= control.min %>" max="<%= control.max %>" step="<%= control.step %>" <% if (control.enabledWhen) { %>data-enabled-when="<%= control.enabledWhen %>"<% } %> /></div></div>
        <% } else if (control.kind === 'select') { %>
          <div class="ui-row control-row"<% if (control.replaced) { %> data-replaced<% } %>><label class="control-label" for="control-<%= control.key %>"><%= control.label %></label><select class="ui-select" id="control-<%= control.key %>" name="<%= control.key %>" <% if (control.enabledWhen) { %>data-enabled-when="<%= control.enabledWhen %>"<% } %>><% control.options.forEach(value => { %><option value="<%= value %>" <%= value === control.initial ? 'selected' : '' %>><%= control.labels?.[value] || (value ? value.replaceAll('-', ' ') : 'None') %></option><% }); %></select></div>
        <% } else { %>
          <div class="ui-row control-row" role="group" aria-labelledby="label-<%= control.key %>"<% if (control.replaced) { %> data-replaced<% } %>><span class="control-label" id="label-<%= control.key %>"><%= control.label %></span><div class="ui-segmented choice-group <%= control.kind === 'icons' ? 'choice-group--icons' : control.key === 'size' ? 'choice-group--sizes' : '' %>"><% control.options.forEach(value => { %><label class="choice" <% if (control.kind === 'icons') { %>title="<%= value %>"<% } %>><input type="radio" name="<%= control.key %>" value="<%= value %>" <% if (control.enabledWhen) { %>data-enabled-when="<%= control.enabledWhen %>"<% } %> <%= value === control.initial ? 'checked' : '' %> <% if (control.kind === 'icons') { %>aria-label="<%= value %>"<% } %> /><span class="ui-segmented__btn"><% if (control.kind === 'icons' && it.icons[value]) { %><%~ it.icons[value] %><% } else { %><%= control.labels?.[value] || (control.key === 'size' && value.length <= 2 ? value.toUpperCase() : value === 'none' && control.kind === 'icons' ? 'None' : value) %><% } %></span></label><% }); %></div></div>
        <% } %>
      <% }); %>
      </section>
      <% }); %>
      </div>
    </form>
  </section>
</div>
<script type="module" src="/dist/playground.js"></script>
