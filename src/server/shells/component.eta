<div class="component-list-layout component-list-layout--detail">
<%~ include('component-list', it) %>
<div class="page-wrap component-page" id="component-content" tabindex="-1" data-component="<%= it.slug %>">
  <header class="page-heading">
    <div class="page-heading__top">
      <a class="text-link component-list-up" href="<%= it.isAddons ? '/addons/' : '/components/' %>"><%~ it.icon('arrow_back') %> <%= it.isAddons ? 'All add-ons' : 'All components' %></a>
      <a class="text-link" href="<%= it.documentationHref %>">Documentation <%~ it.icon('arrow_outward') %></a>
    </div>
    <div class="component-page__title">
      <h1><%= it.component.name %></h1>
      <span class="eyebrow"><%= it.component.group.toUpperCase() %></span>
    </div>
    <p><%= it.component.description %></p>
  </header>
  <div class="framework-chips-row playground--material"><script>(s => { const r = document.documentElement; s.dataset.theme = r.dataset.siteTheme || 'baseline'; s.dataset.themeMode = r.dataset.themeMode; })(document.currentScript.parentElement);</script><%~ it.panel.frameworks %></div>
  <section class="playground playground--material" aria-label="<%= it.component.name %> playground"><%/* The panel's scope takes the site theme and mode as it is parsed, so its first paint is themed. */%><script>(s => { const r = document.documentElement; s.dataset.theme = r.dataset.siteTheme || 'baseline'; s.dataset.themeMode = r.dataset.themeMode; })(document.currentScript.parentElement);</script>
    <div class="preview-panel">
      <div class="panel-heading preview-heading">
        <%~ it.panel.tabs %>
        <span class="preview-dot" aria-hidden="true"></span>
        <%~ it.panel.appearance %>
        <%~ it.panel.copy %>
      </div>
      <div class="playground-space">
        <div id="live-panel" class="playground-view" role="tabpanel" aria-label="Live preview"><iframe id="preview" title="Interactive <%= it.component.name.toLowerCase() %> preview, from the material library" src="/preview/<%= it.slug %>/"></iframe></div>
        <div id="code-panel" class="playground-view code-panel" role="tabpanel" aria-label="View code" tabindex="0" hidden>
          <% if (!it.element) { %><p class="framework-note">Web Components, React, Vue, Svelte and SolidJS come with the <%= it.component.name.toLowerCase() %> web component; the vanilla factory works in any of them today.</p><% } %>
          <pre><code id="generated-code" class="hljs language-javascript"></code></pre>
        </div>
        <% if (it.element) { %><script type="application/json" id="element-meta"><%~ JSON.stringify(it.element).replaceAll('<', '\\u003c') %></script><% } %>
      </div>
      <div class="preview-footer">
        <span id="playground-status" role="status" aria-live="polite">Loading preview…</span>
        <% if (it.size) { const kb = n => (n / 1024).toFixed(1); %><span class="component-size"><% [['factory', it.size.factory], ...(it.element ? [['element', it.size.element]] : [])].forEach(([flavour, size]) => { %><span data-flavour="<%= flavour %>" <%= flavour === 'factory' ? '' : 'hidden' %> title="What this component adds to an app: minified JS and CSS, gzip, on top of the material library's shared core, which all components share and a page loads once.<% if (size.lazy) { %> Another <%= kb(size.lazy) %> KB loads later, only if a feature needs it.<% } %> Measured on material <%= it.size.material %>."><strong><%= kb(size.added) %> KB</strong> gzip</span><% }); %></span><% } %>
      </div>
    </div>
    <form class="split-panel configuration" id="configuration">
      <h2 class="sr-only">Configuration</h2>
      <div class="configuration-body">
      <% if (it.slug === 'chips') { %><input type="hidden" name="selectedChips" id="chips-selectedChips" value="" /><% } %>
      <% if (it.slug === 'checkbox') { %><input type="hidden" name="checkedChildren" id="checkbox-checkedChildren" value="" /><% } %>
        <section class="ui-section scenario-setup">
          <div class="ui-row control-row"><%~ it.panel.scenario %></div>
        </section>
        <% it.panel.sections.forEach(section => { %><section class="ui-section configuration-controls" aria-labelledby="section-<%= section.id %>"><h3 class="ui-title" id="section-<%= section.id %>"><%= section.title %></h3><% section.items.forEach(item => { %><%~ item %><% }); %></section><% }); %>
      </div>
    </form>
  </section>
  <% if (it.usedIn && it.usedIn.length) { %><p class="component-used-in">Used in: <% it.usedIn.forEach((example, index) => { %><% if (index) { %>, <% } %><a class="text-link" href="/showcase/<%= example.slug %>/"><%= example.title %></a><% }); %></p><% } %>
</div>
</div>
<script type="module" src="/dist/playground-material.js"></script>
<script type="module" src="/dist/playground.js"></script>
