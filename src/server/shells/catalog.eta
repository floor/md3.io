<div class="component-list-layout">
  <details class="component-catalog-index" id="component-catalog-index" open>
    <summary class="section-index__toggle">Component index</summary>
    <script>document.currentScript.parentElement.open = matchMedia('(min-width: 840px)').matches;</script>
    <%~ include('component-list', it) %>
  </details>
  <section class="page-wrap component-catalog" aria-label="Component previews">
    <header class="component-catalog__intro">
      <h1>Components</h1>
      <p>Try a component. Adjust the details. Copy what works.</p>
    </header>
    <% it.playgroundDirectory.sections.forEach(section => { %>
      <section class="component-catalog__section" aria-labelledby="catalog-<%= section.id %>">
        <h2 id="catalog-<%= section.id %>"><%= section.name %></h2>
        <div class="component-grid"><% section.items.forEach(({ slug, href }) => { const component = it.components[slug]; %>
          <article class="component-card ui-card">
            <div class="component-card__body"><h3><a href="<%= href %>"><%= component.name %></a></h3><p><%= component.summary %></p></div>
            <%~ it.catalogVisuals[slug] %>
          </article>
        <% }); %></div>
      </section>
    <% }); %>
  </section>
</div>
