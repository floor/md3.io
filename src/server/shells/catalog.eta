<div class="component-list-layout">
  <%~ include('component-list', it) %>
  <section class="page-wrap component-catalog" aria-label="Component previews">
    <div class="component-grid"><% it.playgroundGroups.forEach(group => { group.slugs.forEach(slug => { const component = it.components[slug]; %>
      <a class="component-card ui-card ui-card--interactive" href="/components/<%= slug %>/">
        <%~ it.catalogVisuals[slug] %>
        <div class="component-card__body"><h2><%= component.name %></h2><p><%= component.summary %></p></div>
      </a>
    <% }); }); %></div>
  </section>
</div>
