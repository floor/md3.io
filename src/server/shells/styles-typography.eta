<%
  const label = role => role.charAt(0).toUpperCase() + role.slice(1).replaceAll('-', ' ');
  const px = value => value.replace(/px$/, '');
  const sample = 'The quick brown fox jumps over the lazy dog';
%>
<div class="page-wrap styles-page styles-typography" data-styles-page="typography">
  <header class="page-heading"><span class="eyebrow">STYLES / TYPOGRAPHY</span><h1>Typography</h1><p>The Material 3 type scale: five roles in three sizes, as mtrl ships them.</p></header>
  <p class="styles-source">Values read from mtrl's compiled CSS · mtrl <%= it.mtrlVersion %></p>
  <div class="styles-toolbar styles-toolbar--sample">
    <label for="type-sample">Sample text</label>
    <input id="type-sample" class="ui-input styles-sample-input" type="text" value="<%= sample %>" maxlength="120" autocomplete="off" spellcheck="false" />
    <span class="styles-status sr-only" id="styles-status" role="status" aria-live="polite"></span>
  </div>
  <% if (it.unloadedFonts.length) { %><p class="styles-note">mtrl's type scale names <%= it.unloadedFonts.join(', ') %>, which md3.io does not load: the samples show <%= it.unloadedFonts.join(', ') %> if it is installed on your device, otherwise your browser's fallback in the same stack.</p><% } %>
  <ol class="type-scale">
    <% it.typescale.forEach(style => { %>
    <li class="type-row" data-role="<%= style.role %>">
      <div class="type-row__head">
        <h2 class="type-row__name"><%= label(style.role) %></h2>
        <p class="type-row__spec"><span><%= style.font %></span> · <span><%= px(style.fontSize) %>/<%= px(style.lineHeight) %> px</span> · <span>weight <%= style.fontWeight %></span> · <span>tracking <%= style.letterSpacing %></span></p>
      </div>
      <p class="type-row__sample" style="font-family:<%= style.font %>;font-size:<%= style.fontSize %>;line-height:<%= style.lineHeight %>;letter-spacing:<%= style.letterSpacing %>;font-weight:<%= style.fontWeight %>"><%= sample %></p>
      <div class="type-row__copies">
        <% if (style.utility) { %><span class="type-row__copy"><code>.mtrl-<%= style.role %></code><button type="button" class="ui-btn" data-copy="mtrl-<%= style.role %>" aria-label="Copy class mtrl-<%= style.role %>">Copy</button></span><% } %>
        <span class="type-row__copy"><code>var(--mtrl-sys-typescale-<%= style.role %>-font-size)</code><button type="button" class="ui-btn" data-copy="var(--mtrl-sys-typescale-<%= style.role %>-font-size)" aria-label="Copy var(--mtrl-sys-typescale-<%= style.role %>-font-size)">Copy</button></span>
      </div>
    </li>
    <% }); %>
  </ol>
</div>
