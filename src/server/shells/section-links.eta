<% it.sidebarGroups.forEach(group => { %>
  <div class="sidebar__group">
    <div class="mtrl-drawer__section-label"><%= group.label %></div>
    <% group.items.forEach(item => { %>
      <%~ include('sidebar-link', { path: it.path, item }) %>
    <% }); %>
  </div>
<% }); %>
<% if (it.docComponentEntries.length) { %>
  <div class="sidebar__group">
    <h2 class="mtrl-drawer__section-label" id="<%= it.heading %>">Components</h2>
    <%~ include('component-directory', { heading: it.heading, entries: it.docComponentEntries, path: it.path, icon: it.icon }) %>
  </div>
<% } %>
