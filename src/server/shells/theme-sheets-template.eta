<%/* Every theme's two sheets as a compact map, theme → [main hash, contrast hash] (the
     server reads them from the asset manifest; '' before a build, for the plain name).
     theme-sheets.eta (the frames) and the page head write the active theme's sheets from
     it; src/client/theme-sheets.ts loads another theme's. */%>
  <script type="application/json" id="theme-sheets"><%~ it.themeSheets %></script>
