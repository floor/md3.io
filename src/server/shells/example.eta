<div class="page-wrap example-page" data-example="<%= it.example.slug %>">
  <nav class="framework-tabs" role="tablist" aria-label="Framework">
  <% it.variants.forEach((variant, i) => { %>
    <button type="button" class="framework-tab" role="tab" id="tab-<%= variant.id %>" data-framework="<%= variant.id %>"
      aria-selected="<%= i === 0 ? 'true' : 'false' %>" aria-controls="example-frame" <%= i === 0 ? '' : 'tabindex="-1"' %>><%= variant.label %></button>
  <% }); %>
  </nav>
  <header class="page-heading"><h1><%= it.example.title %></h1><p><%= it.example.description %></p></header>
  <div class="example-layout">
    <div class="example-main">
      <section class="preview-panel example-preview" aria-label="Running example">
        <iframe id="example-frame" title="<%= it.example.title %> example" src="/examples/<%= it.example.slug %>/frame/<%= it.variants[0].id %>/"></iframe>
        <div class="preview-footer">
          <span id="example-status" role="status" aria-live="polite"></span>
          <div class="preview-appearance" role="group" aria-label="Example appearance">
            <label for="example-theme">Theme</label>
            <select id="example-theme" class="ui-select"><% it.themes.forEach(theme => { %><option value="<%= theme %>"><%= (theme.charAt(0).toUpperCase() + theme.slice(1)).replaceAll('-', ' ') %></option><% }); %></select>
            <div class="ui-segmented choice-group choice-group--mode" role="group" aria-label="Example mode">
              <label class="choice"><input name="example-mode" type="radio" value="light" checked /><span class="ui-segmented__btn">Light</span></label>
              <label class="choice"><input name="example-mode" type="radio" value="dark" /><span class="ui-segmented__btn">Dark</span></label>
            </div>
          </div>
        </div>
      </section>
      <section class="preview-panel example-code" aria-label="Source">
      <% it.variants.forEach((variant, i) => { %>
        <div class="example-source" data-framework="<%= variant.id %>" <%= i === 0 ? '' : 'hidden' %>>
          <div class="panel-heading">
            <div class="preview-tabs" role="tablist" aria-label="<%= variant.label %> files">
            <% variant.files.forEach((file, j) => { %>
              <button type="button" class="preview-tab" role="tab" data-file="<%= j %>" aria-selected="<%= j === 0 ? 'true' : 'false' %>" <%= j === 0 ? '' : 'tabindex="-1"' %>><%= file.name %></button>
            <% }); %>
            </div>
            <button class="ui-btn preview-copy" type="button" data-copy>Copy code</button>
          </div>
          <% variant.files.forEach((file, j) => { %>
            <pre class="example-file" data-file="<%= j %>" <%= j === 0 ? '' : 'hidden' %>><code class="hljs"><%~ file.html %></code></pre>
          <% }); %>
        </div>
      <% }); %>
      </section>
    </div>
    <aside class="split-panel example-aside">
      <section class="ui-section"><h2 class="ui-title">ABOUT</h2><% it.example.about.forEach(p => { %><p><%~ p %></p><% }); %></section>
      <section class="ui-section"><h2 class="ui-title">HOW IT WORKS</h2><% it.example.how.forEach(p => { %><p><%~ p %></p><% }); %></section>
      <section class="ui-section"><h2 class="ui-title">BUNDLE</h2>
        <p>Everything this page runs, gzipped:</p>
        <dl class="example-sizes"><% it.variants.forEach(variant => { %><div data-framework="<%= variant.id %>"><dt><%= variant.label %></dt><dd><%= (variant.gzip / 1024).toFixed(1) %> KB</dd></div><% }); %></dl>
      </section>
      <section class="ui-section"><h2 class="ui-title">COMPONENTS</h2>
        <p><% it.example.components.forEach((slug, i) => { %><a class="text-link" href="/components/<%= slug %>/"><%= slug %></a><%= i < it.example.components.length - 1 ? ', ' : '' %><% }); %></p>
      </section>
    </aside>
  </div>
</div>
