<div class="page-wrap docs-overview"><header class="page-heading"><span class="eyebrow">THE COMPONENT REFERENCE</span><h1>Documentation</h1><p>Configuration, methods, and examples for building with mtrl.</p></header>
<a class="architecture-link ui-card ui-card--interactive" href="/docs/components/components/"><span><strong>Start with the architecture</strong><br>Understand components, composition, and the core API.</span></a>
<% it.docGroups.forEach(group => { %><section class="docs-group"><h2 class="catalog-label"><%= group.label %></h2><div class="docs-grid"><% group.items.forEach(item => { %><a href="<%= item.href %>" class="doc-entry ui-card ui-card--interactive"><span class="doc-entry__name"><%= item.name %></span><span class="doc-entry__summary"><%= item.summary %></span></a><% }); %></div></section><% }); %>
</div>
