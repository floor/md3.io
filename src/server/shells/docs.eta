<div class="page-wrap docs-overview"><header class="page-hero"><div class="page-hero__text"><h1>Docs</h1><p>How to start, how <code>material</code> works in your framework, and every component's configuration, methods and events.</p></div><div class="page-hero__art" aria-hidden="true"></div></header>
<div class="page-hero-body"><% [it.guideGroup, ...it.docGroups].filter(group => group.items.length).forEach(group => { %><section class="docs-group"><h2 class="catalog-label"><%= group.label %></h2><div class="docs-grid"><% group.items.forEach(item => { %><a href="<%= item.href %>" class="doc-entry ui-card ui-card--interactive"><span class="doc-entry__name"><%= item.name %></span><span class="doc-entry__summary"><%= item.summary %></span></a><% }); %></div></section><% }); %></div>
</div>
