<dialog class="search-overlay" id="search-dialog" aria-label="Search the site">
  <div class="search-dialog">
    <div class="search-dialog__input-wrap">
      <svg class="search-dialog__input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      <input class="search-dialog__input" id="search-input" type="text" placeholder="Search components, docs, examples..." aria-label="Search components, docs and examples" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="search-listbox" autocomplete="off" spellcheck="false" autofocus />
      <button class="search-dialog__input-esc" id="search-esc" type="button" aria-label="Close search">Esc</button>
    </div>
    <div class="search-dialog__results" id="search-results"></div>
    <div class="search-dialog__footer" aria-hidden="true">
      <span class="search-dialog__footer-hint"><span class="search-dialog__footer-key">↑</span><span class="search-dialog__footer-key">↓</span>navigate</span>
      <span class="search-dialog__footer-hint"><span class="search-dialog__footer-key">↵</span>open</span>
      <span class="search-dialog__footer-hint"><span class="search-dialog__footer-key">esc</span>close</span>
    </div>
  </div>
</dialog>
