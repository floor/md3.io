<!doctype html><html lang="en" data-theme="baseline" data-theme-mode="light" data-component="<%= it.slug %>"<% if (it.component.previewLayout) { %> data-preview-layout="<%= it.component.previewLayout %>"<% } %>><head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title><%= it.component.name %> preview</title>
  <script>
    (() => {
      const root = document.documentElement;
      try {
        const saved = JSON.parse(localStorage.getItem('md3-preview-appearance') || '{}');
        if (<%~ JSON.stringify(it.themes) %>.includes(saved?.theme)) root.dataset.theme = saved.theme;
        root.dataset.themeMode = saved?.mode === 'dark' ? 'dark' : 'light';
      } catch {}
      root.style.colorScheme = root.dataset.themeMode;
    })();
  </script>
  <link rel="preload" href="/fonts/Roboto-latin-wght.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="stylesheet" href="/styles/roboto.css" />
  <link rel="stylesheet" href="/dist/material/styles/base.css" />
  <link rel="stylesheet" href="/dist/material/styles/typography.css" />
  <% [...it.component.styles, ...(it.component.previewStyles || [])].forEach(style => { %><link rel="stylesheet" href="/dist/material/styles/<%= style %>.css" /><% }); %>
  <% it.addonStyles.forEach(style => { %><link rel="stylesheet" href="/dist/material-addons/<%= style %>.css" /><% }); %>
  <%~ include('theme-sheets', { themeSheets: it.themeSheets }) %>
  <link rel="stylesheet" href="/styles/preview.css" />
  <script type="module" src="/dist/preview.js"></script>
</head><body><main id="stage" aria-label="Component preview"></main></body></html>
