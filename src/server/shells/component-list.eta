<% const heading = it.inRail ? 'rail-component-directory-heading' : 'component-directory-heading'; %>
<nav class="<%= it.inRail ? 'site-nav-dialog__section' : 'component-list' %>" aria-label="Component list">
  <h2 class="mtrl-drawer__section-label" id="<%= heading %>">Components</h2>
  <%~ include('component-directory', { heading, entries: it.playgroundDirectory.entries, path: it.path, icon: it.icon }) %>
  <% if (it.isCatalog) { %><p class="catalog-note"><a href="/docs/">Browse the complete component reference <%~ it.icon('arrow_forward') %></a></p><% } %>
</nav>
