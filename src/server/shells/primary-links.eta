<nav class="site-nav-links" aria-label="Primary navigation">
  <% it.primaryDestinations.forEach(destination => { %>
    <% const current = it.path === destination.href ? 'page' : it.section === destination.label ? 'location' : ''; %>
    <a class="site-nav-link" href="<%= destination.href %>"<% if (current) { %> aria-current="<%= current %>"<% } %>>
      <span class="site-nav-link__icon"><%~ it.icon(destination.icon) %></span>
      <span class="site-nav-link__label"><%= destination.label %></span>
    </a>
  <% }); %>
</nav>
