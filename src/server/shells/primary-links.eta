<nav class="site-nav-links" aria-label="Primary navigation">
  <% it.primaryDestinations.forEach(destination => { %>
    <% const current = it.path === destination.href ? 'page' : it.section === destination.label ? 'location' : ''; %>
    <a class="<%= it.drawer ? 'mtrl-drawer__item' + (current ? ' mtrl-drawer__item--active' : '') : 'site-nav-link' %>" href="<%= destination.href %>"<% if (current) { %> aria-current="<%= current %>"<% } %>>
      <% if (it.drawer) { %><span class="mtrl-drawer__active-indicator" aria-hidden="true"></span><% } %>
      <span class="<%= it.drawer ? 'mtrl-drawer__item-icon' : 'site-nav-link__icon' %>"><%~ it.icon(destination.icon) %></span>
      <span class="<%= it.drawer ? 'mtrl-drawer__item-label' : 'site-nav-link__label' %>"><%= destination.label %></span>
    </a>
  <% }); %>
</nav>
